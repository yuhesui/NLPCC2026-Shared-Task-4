    },
    {
      "name": "sector_without_news",
      "agent_name": "sector_rotation",
      "track": "sector",
      "load_news": false,
      "ablation": "sector-without-news",
      "group": "track2",
      "agent_params": {
        "track": "sector",
        "use_news": false,
        "news_weight": 0.0,
        "trend_weight": 0.85,
        "graph_weight": 0.15,
        "constraints": {
          "max_weight": 0.5,
          "cash_reserve": 0.03,
          "max_turnover": 0.6
        }
      }
    },
    {
      "name": "oco_fallback_macro",
      "agent_name": "oco_ensemble",
      "track": "macro",
      "load_news": true,
      "ablation": "base",
      "group": "fallback",
      "agent_params": {
        "track": "macro",
        "constraints": {
          "max_weight": 0.7,
          "cash_reserve": 0.03,
          "max_turnover": 0.6
        }
      }
    },
    {
      "name": "oco_without_text",
      "agent_name": "oco_ensemble",
      "track": "macro",
      "load_news": false,
      "ablation": "oco-without-text",
      "group": "fallback",
      "agent_params": {
        "track": "macro",
        "constraints": {
          "max_weight": 0.7,
          "cash_reserve": 0.03,
          "max_turnover": 0.6
        },
        "experts": [
          {
            "name": "s1_quant_core",
            "prior_weight": 0.55,
            "config": {
              "track": "macro",
              "max_weight": 0.7
            }
          },
          {
            "name": "risk_parity",
            "prior_weight": 0.35,
            "config": {
              "track": "macro",
              "constraints": {
                "max_weight": 0.7,
                "cash_reserve": 0.03,
                "max_turnover": 0.6
              }
            }
          },
          {
            "name": "conservative_ensemble",
            "prior_weight": 0.1,
            "config": {
              "track": "macro",
              "constraints": {
                "max_weight": 0.7,
                "cash_reserve": 0.03,
                "max_turnover": 0.6
              }
            }
          }
        ]
      }
