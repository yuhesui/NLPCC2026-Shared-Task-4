# Copy to .env (never commit .env). Values are read by scripts/live/* only.
# Personal Codabench API token (official client: uploads + receipts).
CODABENCH_TOKEN=
# Organizer-issued profile, e.g. third_party/icaif_starter_kit/starter-kit/profiles/profile99-production.json
ICAIF_PROFILE=
# Path to the official starter-kit root (directory that contains kit/ and tools/).
ICAIF_KIT_ROOT=third_party/icaif_starter_kit/starter-kit
# Private credentials normally live in .icaif/credentials.json (created by the official client).
TEAM_ID=
TEAM_TOKEN=
# SEC EDGAR requires a descriptive User-Agent with a contact address.
SEC_USER_AGENT=
# Hosted LLMs (optional; only organizer-listed models). Leave empty to disable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
